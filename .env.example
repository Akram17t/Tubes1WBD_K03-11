APP_ADDR=:8080
APP_ENV=development
PLATFORM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable
# Base64 encoding of 32 random bytes; retain this key to decrypt saved passwords.
CONNECTION_ENCRYPTION_KEY=

SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Milestone 2: peran proses dan worker. Jalankan dua proses dengan APP_ROLE=api dan APP_ROLE=worker.
APP_ROLE=api
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1s
WORKER_HEARTBEAT_INTERVAL=5s
# Harus lebih besar dari WORKER_HEARTBEAT_INTERVAL. Heartbeat basi hanya memicu recovery, bukan bukti worker mati.
JOB_STALE_AFTER=30s
BATCH_SIZE_DEFAULT=1000
BATCH_SIZE_MAX=10000
