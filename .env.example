APP_ADDR=:8080
APP_ENV=development
PLATFORM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable
# Base64 encoding of 32 random bytes; retain this key to decrypt saved passwords.
CONNECTION_ENCRYPTION_KEY=

SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
